{
  "name": "smartai-attendance",
  "version": "1.0.0",
  "description": "SmartAi Attendance by 3SL Media Labs — full-stack Railway deployment",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:api": "node --watch server/index.js",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:client\"",
    "build": "vite build",
    "start": "node server/index.js",
    "railway": "npm run build && npm run start"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "vite": "^5.0.0"
  }
}
